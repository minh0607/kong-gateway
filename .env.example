# Required. Auto-generated by deploy.sh on first install via `openssl rand -hex 32`.
# Refuse-to-boot if missing or equal to the legacy default value.
SESSION_SECRET=replace-me-with-a-32-byte-hex-string

# Internal database password — auto-generated by deploy.sh.
# Changing this on an existing install requires `docker compose down -v`
# (which DESTROYS Kong's data). Don't change unless you intend that.
KONG_PG_PASSWORD=replace-me-with-a-random-string

# Required. Set to your internal SMTP relay hostname or IP.
# Override per-environment via /data/smtp.json (admin GUI: SMTP Settings card).
SMTP_HOST=mail.internal

# Optional. SMTP credentials. Leave empty if the relay accepts unauthenticated mail.
SMTP_USER=
SMTP_PASS=

# Optional. Set to `true` to require MFA for every user, ignoring per-user toggles.
# Default false. Use as a kill-switch / compliance lockdown.
MFA_ENFORCED=false

    {
      "id": 17,
      "type": "logs",
      "title": "System error logs \u2014 Kong stack (proxy / DB / usermgmt / auth-proxy)",
      "description": "Error-level lines from all Kong containers via Loki. Source = container label.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 56
      },
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"docker\"} |~ `(?i)error|fatal|panic|emerg|critical|\\[crit\\]`",
          "queryType": "range",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ]
    },

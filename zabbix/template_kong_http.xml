<?xml version="1.0" encoding="UTF-8"?>
<zabbix_export>
    <version>7.0</version>
    <template_groups>
        <template_group>
            <uuid>8a1750d7efc947c89f64488a5fee5319</uuid>
            <name>Templates/Applications</name>
        </template_group>
    </template_groups>
    <templates>
        <template>
            <uuid>9c0df3cd9f2040eba3477613e0a20c04</uuid>
            <template>Kong Gateway by HTTP</template>
            <name>Kong Gateway by HTTP</name>
            <description>Monitors Kong OSS via the Prometheus plugin exposed on the Status API (/metrics on port 8100).&#13;&#10;Scrapes once with an HTTP agent master item, then extracts metrics with Prometheus pattern preprocessing. Per-route metrics are auto-discovered via LLD.&#13;&#10;Attach to a host whose interface IP/DNS is the Kong box. Requires the Prometheus plugin enabled on Kong (status_code + latency + bandwidth metrics).</description>
            <groups>
                <group>
                    <name>Templates/Applications</name>
                </group>
            </groups>
            <items>
                <item>
                    <uuid>27109b314a8545ad9426d8c14a8fb57c</uuid>
                    <name>Kong: raw metrics</name>
                    <type>HTTP_AGENT</type>
                    <key>kong.metrics.raw</key>
                    <delay>{$KONG.SCRAPE.INTERVAL}</delay>
                    <history>0</history>
                    <trends>0</trends>
                    <value_type>TEXT</value_type>
                    <description>Raw Prometheus exposition pulled from Kong Status API. Master item for all dependent metrics; not stored.</description>
                    <timeout>10s</timeout>
                    <url>http://{HOST.CONN}:{$KONG.STATUS.PORT}/metrics</url>
                    <tags>
                        <tag>
                            <tag>component</tag>
                            <value>raw</value>
                        </tag>
                    </tags>
                </item>
                <item>
                    <uuid>06b4ec78129f4e939d3767740bb4a0d8</uuid>
                    <name>Kong: datastore reachable</name>
                    <type>DEPENDENT</type>
                    <key>kong.datastore_reachable</key>
                    <value_type>UNSIGNED</value_type>
                    <description>1 = Kong can reach its Postgres datastore, 0 = cannot.</description>
                    <valuemap>
                        <name>Kong reachable</name>
                    </valuemap>
                    <preprocessing>
                        <step>
                            <type>PROMETHEUS_PATTERN</type>
                            <parameters>
                                <parameter>kong_datastore_reachable</parameter>
                                <parameter>value</parameter>
                                <parameter/>
                            </parameters>
                        </step>
                    </preprocessing>
                    <master_item>
                        <key>kong.metrics.raw</key>
                    </master_item>
                    <tags>
                        <tag>
                            <tag>component</tag>
                            <value>health</value>
                        </tag>
                    </tags>
                </item>
                <item>
                    <uuid>ca60f2440aa043caa132aeceba8a2bf6</uuid>
                    <name>Kong: active connections</name>
                    <type>DEPENDENT</type>
                    <key>kong.connections.active</key>
                    <value_type>UNSIGNED</value_type>
                    <description>Active nginx connections handled by Kong.</description>
                    <preprocessing>
                        <step>
                            <type>PROMETHEUS_PATTERN</type>
                            <parameters>
                                <parameter>kong_nginx_connections_total{state="active"}</parameter>
                                <parameter>sum</parameter>
                                <parameter/>
                            </parameters>
                        </step>
                    </preprocessing>
                    <master_item>
                        <key>kong.metrics.raw</key>
                    </master_item>
                    <tags>
                        <tag>
                            <tag>component</tag>
                            <value>health</value>
                        </tag>
                    </tags>
                </item>
                <item>
                    <uuid>19495b31e6734ea2b5a131f0511d9197</uuid>
                    <name>Kong: total request rate</name>
                    <type>DEPENDENT</type>
                    <key>kong.requests.rate</key>
                    <value_type>FLOAT</value_type>
                    <units>rps</units>
                    <description>Requests per second across all routes.</description>
                    <preprocessing>
                        <step>
                            <type>PROMETHEUS_PATTERN</type>
                            <parameters>
                                <parameter>kong_http_requests_total</parameter>
                                <parameter>sum</parameter>
                                <parameter/>
                            </parameters>
                        </step>
                        <step>
                            <type>CHANGE_PER_SECOND</type>
                            <parameters/>
                        </step>
                    </preprocessing>
                    <master_item>
                        <key>kong.metrics.raw</key>
                    </master_item>
                    <tags>
                        <tag>
                            <tag>component</tag>
                            <value>traffic</value>
                        </tag>
                    </tags>
                </item>
                <item>
                    <uuid>1123be35882f4a8780d8be1f66cd7dd7</uuid>
                    <name>Kong: 5xx response rate</name>
                    <type>DEPENDENT</type>
                    <key>kong.requests.5xx.rate</key>
                    <value_type>FLOAT</value_type>
                    <units>rps</units>
                    <description>5xx responses per second across all routes.</description>
                    <preprocessing>
                        <step>
                            <type>PROMETHEUS_PATTERN</type>
                            <parameters>
                                <parameter>kong_http_requests_total{code=~"5.."}</parameter>
                                <parameter>sum</parameter>
                                <parameter/>
                            </parameters>
                            <error_handler>CUSTOM_VALUE</error_handler>
                            <error_handler_params>0</error_handler_params>
                        </step>
                        <step>
                            <type>CHANGE_PER_SECOND</type>
                            <parameters/>
                        </step>
                    </preprocessing>
                    <master_item>
                        <key>kong.metrics.raw</key>
                    </master_item>
                    <tags>
                        <tag>
                            <tag>component</tag>
                            <value>errors</value>
                        </tag>
                    </tags>
                </item>
            </items>
            <discovery_rules>
                <discovery_rule>
                    <uuid>589a4afc39e64a30a3c595bb3395a817</uuid>
                    <name>Kong: route discovery</name>
                    <type>DEPENDENT</type>
                    <key>kong.route.discovery</key>
                    <delay>0</delay>
                    <description>Discovers proxied routes from kong_kong_latency_ms_count (one series per route).</description>
                    <item_prototypes>
                        <item_prototype>
                            <uuid>0590cb1ec36d414da12621f3033ea868</uuid>
                            <name>Route [{#ROUTE}]: request rate</name>
                            <type>DEPENDENT</type>
                            <key>kong.route.requests.rate[{#ROUTE}]</key>
                            <value_type>FLOAT</value_type>
                            <units>rps</units>
                            <preprocessing>
                                <step>
                                    <type>PROMETHEUS_PATTERN</type>
                                    <parameters>
                                        <parameter>kong_http_requests_total{route="{#ROUTE}"}</parameter>
                                        <parameter>sum</parameter>
                                        <parameter/>
                                    </parameters>
                                </step>
                                <step>
                                    <type>CHANGE_PER_SECOND</type>
                                    <parameters/>
                                </step>
                            </preprocessing>
                            <master_item>
                                <key>kong.metrics.raw</key>
                            </master_item>
                            <tags>
                                <tag>
                                    <tag>component</tag>
                                    <value>traffic</value>
                                </tag>
                                <tag>
                                    <tag>route</tag>
                                    <value>{#ROUTE}</value>
                                </tag>
                            </tags>
                        </item_prototype>
                        <item_prototype>
                            <uuid>19e055f14d1542cca9f7b607f9ac19f4</uuid>
                            <name>Route [{#ROUTE}]: 4xx rate</name>
                            <type>DEPENDENT</type>
                            <key>kong.route.requests.4xx.rate[{#ROUTE}]</key>
                            <value_type>FLOAT</value_type>
                            <units>rps</units>
                            <preprocessing>
                                <step>
                                    <type>PROMETHEUS_PATTERN</type>
                                    <parameters>
                                        <parameter>kong_http_requests_total{route="{#ROUTE}",code=~"4.."}</parameter>
                                        <parameter>sum</parameter>
                                        <parameter/>
                                    </parameters>
                                    <error_handler>CUSTOM_VALUE</error_handler>
                                    <error_handler_params>0</error_handler_params>
                                </step>
                                <step>
                                    <type>CHANGE_PER_SECOND</type>
                                    <parameters/>
                                </step>
                            </preprocessing>
                            <master_item>
                                <key>kong.metrics.raw</key>
                            </master_item>
                            <tags>
                                <tag>
                                    <tag>component</tag>
                                    <value>errors</value>
                                </tag>
                                <tag>
                                    <tag>route</tag>
                                    <value>{#ROUTE}</value>
                                </tag>
                            </tags>
                        </item_prototype>
                        <item_prototype>
                            <uuid>672bdc4372a74a7eb3aea970d385564e</uuid>
                            <name>Route [{#ROUTE}]: 5xx rate</name>
                            <type>DEPENDENT</type>
                            <key>kong.route.requests.5xx.rate[{#ROUTE}]</key>
                            <value_type>FLOAT</value_type>
                            <units>rps</units>
                            <preprocessing>
                                <step>
                                    <type>PROMETHEUS_PATTERN</type>
                                    <parameters>
                                        <parameter>kong_http_requests_total{route="{#ROUTE}",code=~"5.."}</parameter>
                                        <parameter>sum</parameter>
                                        <parameter/>
                                    </parameters>
                                    <error_handler>CUSTOM_VALUE</error_handler>
                                    <error_handler_params>0</error_handler_params>
                                </step>
                                <step>
                                    <type>CHANGE_PER_SECOND</type>
                                    <parameters/>
                                </step>
                            </preprocessing>
                            <master_item>
                                <key>kong.metrics.raw</key>
                            </master_item>
                            <tags>
                                <tag>
                                    <tag>component</tag>
                                    <value>errors</value>
                                </tag>
                                <tag>
                                    <tag>route</tag>
                                    <value>{#ROUTE}</value>
                                </tag>
                            </tags>
                        </item_prototype>
                        <item_prototype>
                            <uuid>d38ecae6f4a946639156cb97c64dd4dd</uuid>
                            <name>Route [{#ROUTE}]: egress bandwidth</name>
                            <type>DEPENDENT</type>
                            <key>kong.route.bandwidth.egress.rate[{#ROUTE}]</key>
                            <value_type>FLOAT</value_type>
                            <units>Bps</units>
                            <preprocessing>
                                <step>
                                    <type>PROMETHEUS_PATTERN</type>
                                    <parameters>
                                        <parameter>kong_bandwidth_bytes{route="{#ROUTE}",direction="egress"}</parameter>
                                        <parameter>sum</parameter>
                                        <parameter/>
                                    </parameters>
                                    <error_handler>CUSTOM_VALUE</error_handler>
                                    <error_handler_params>0</error_handler_params>
                                </step>
                                <step>
                                    <type>CHANGE_PER_SECOND</type>
                                    <parameters/>
                                </step>
                            </preprocessing>
                            <master_item>
                                <key>kong.metrics.raw</key>
                            </master_item>
                            <tags>
                                <tag>
                                    <tag>component</tag>
                                    <value>traffic</value>
                                </tag>
                                <tag>
                                    <tag>route</tag>
                                    <value>{#ROUTE}</value>
                                </tag>
                            </tags>
                        </item_prototype>
                        <item_prototype>
                            <uuid>0b174f584d6d4f5fa759480f7aad2bc7</uuid>
                            <name>Route [{#ROUTE}]: ingress bandwidth</name>
                            <type>DEPENDENT</type>
                            <key>kong.route.bandwidth.ingress.rate[{#ROUTE}]</key>
                            <value_type>FLOAT</value_type>
                            <units>Bps</units>
                            <preprocessing>
                                <step>
                                    <type>PROMETHEUS_PATTERN</type>
                                    <parameters>
                                        <parameter>kong_bandwidth_bytes{route="{#ROUTE}",direction="ingress"}</parameter>
                                        <parameter>sum</parameter>
                                        <parameter/>
                                    </parameters>
                                    <error_handler>CUSTOM_VALUE</error_handler>
                                    <error_handler_params>0</error_handler_params>
                                </step>
                                <step>
                                    <type>CHANGE_PER_SECOND</type>
                                    <parameters/>
                                </step>
                            </preprocessing>
                            <master_item>
                                <key>kong.metrics.raw</key>
                            </master_item>
                            <tags>
                                <tag>
                                    <tag>component</tag>
                                    <value>traffic</value>
                                </tag>
                                <tag>
                                    <tag>route</tag>
                                    <value>{#ROUTE}</value>
                                </tag>
                            </tags>
                        </item_prototype>
                        <item_prototype>
                            <uuid>acc054fbfc3d442fbeda1b2713ad287b</uuid>
                            <name>Route [{#ROUTE}]: latency sum rate (internal)</name>
                            <type>DEPENDENT</type>
                            <key>kong.route.latency.sum.rate[{#ROUTE}]</key>
                            <value_type>FLOAT</value_type>
                            <description>Internal: per-second growth of cumulative Kong latency, used to derive avg latency.</description>
                            <preprocessing>
                                <step>
                                    <type>PROMETHEUS_PATTERN</type>
                                    <parameters>
                                        <parameter>kong_kong_latency_ms_sum{route="{#ROUTE}"}</parameter>
                                        <parameter>sum</parameter>
                                        <parameter/>
                                    </parameters>
                                </step>
                                <step>
                                    <type>CHANGE_PER_SECOND</type>
                                    <parameters/>
                                </step>
                            </preprocessing>
                            <master_item>
                                <key>kong.metrics.raw</key>
                            </master_item>
                            <tags>
                                <tag>
                                    <tag>component</tag>
                                    <value>internal</value>
                                </tag>
                                <tag>
                                    <tag>route</tag>
                                    <value>{#ROUTE}</value>
                                </tag>
                            </tags>
                        </item_prototype>
                        <item_prototype>
                            <uuid>b640adbbfe7741b79d689d0222f10b4a</uuid>
                            <name>Route [{#ROUTE}]: latency count rate (internal)</name>
                            <type>DEPENDENT</type>
                            <key>kong.route.latency.count.rate[{#ROUTE}]</key>
                            <value_type>FLOAT</value_type>
                            <description>Internal: per-second growth of request count, used to derive avg latency.</description>
                            <preprocessing>
                                <step>
                                    <type>PROMETHEUS_PATTERN</type>
                                    <parameters>
                                        <parameter>kong_kong_latency_ms_count{route="{#ROUTE}"}</parameter>
                                        <parameter>sum</parameter>
                                        <parameter/>
                                    </parameters>
                                </step>
                                <step>
                                    <type>CHANGE_PER_SECOND</type>
                                    <parameters/>
                                </step>
                            </preprocessing>
                            <master_item>
                                <key>kong.metrics.raw</key>
                            </master_item>
                            <tags>
                                <tag>
                                    <tag>component</tag>
                                    <value>internal</value>
                                </tag>
                                <tag>
                                    <tag>route</tag>
                                    <value>{#ROUTE}</value>
                                </tag>
                            </tags>
                        </item_prototype>
                        <item_prototype>
                            <uuid>db1a4dc5b04e4bbf9bbd48ee25bf7a58</uuid>
                            <name>Route [{#ROUTE}]: avg latency (Kong)</name>
                            <type>CALCULATED</type>
                            <key>kong.route.latency.avg[{#ROUTE}]</key>
                            <delay>{$KONG.SCRAPE.INTERVAL}</delay>
                            <value_type>FLOAT</value_type>
                            <units>ms</units>
                            <params>last(//kong.route.latency.sum.rate[{#ROUTE}])/last(//kong.route.latency.count.rate[{#ROUTE}])</params>
                            <description>Recent average Kong-processing latency = delta(latency sum) / delta(request count).</description>
                            <tags>
                                <tag>
                                    <tag>component</tag>
                                    <value>latency</value>
                                </tag>
                                <tag>
                                    <tag>route</tag>
                                    <value>{#ROUTE}</value>
                                </tag>
                            </tags>
                        </item_prototype>
                    </item_prototypes>
                    <trigger_prototypes>
                        <trigger_prototype>
                            <uuid>56a67e65bce8486cb380d886b887289e</uuid>
                            <expression>avg(/Kong Gateway by HTTP/kong.route.requests.5xx.rate[{#ROUTE}],5m)&gt;{$KONG.5XX.RATE.WARN}</expression>
                            <name>Kong route {#ROUTE}: high 5xx rate (&gt;{$KONG.5XX.RATE.WARN} rps for 5m)</name>
                            <priority>WARNING</priority>
                            <description>Sustained 5xx responses on route {#ROUTE}.</description>
                            <tags>
                                <tag>
                                    <tag>scope</tag>
                                    <value>availability</value>
                                </tag>
                            </tags>
                        </trigger_prototype>
                    </trigger_prototypes>
                    <lld_macro_paths>
                        <lld_macro_path>
                            <lld_macro>{#ROUTE}</lld_macro>
                            <path>$.labels.route</path>
                        </lld_macro_path>
                        <lld_macro_path>
                            <lld_macro>{#SERVICE}</lld_macro>
                            <path>$.labels.service</path>
                        </lld_macro_path>
                    </lld_macro_paths>
                    <preprocessing>
                        <step>
                            <type>PROMETHEUS_TO_JSON</type>
                            <parameters>
                                <parameter>kong_kong_latency_ms_count</parameter>
                            </parameters>
                        </step>
                    </preprocessing>
                    <master_item>
                        <key>kong.metrics.raw</key>
                    </master_item>
                </discovery_rule>
            </discovery_rules>
            <tags>
                <tag>
                    <tag>service</tag>
                    <value>kong</value>
                </tag>
            </tags>
            <macros>
                <macro>
                    <macro>{$KONG.STATUS.PORT}</macro>
                    <value>8100</value>
                    <description>Kong Status API port serving /metrics.</description>
                </macro>
                <macro>
                    <macro>{$KONG.SCRAPE.INTERVAL}</macro>
                    <value>60s</value>
                    <description>How often Zabbix scrapes /metrics.</description>
                </macro>
                <macro>
                    <macro>{$KONG.NODATA}</macro>
                    <value>5m</value>
                    <description>No-data window before the metrics-unreachable trigger fires.</description>
                </macro>
                <macro>
                    <macro>{$KONG.5XX.RATE.WARN}</macro>
                    <value>1</value>
                    <description>5xx responses-per-second threshold for warning triggers.</description>
                </macro>
            </macros>
            <valuemaps>
                <valuemap>
                    <uuid>3f2a9b6c8d1e4a7fb2c5d8e0a1b3c4d5</uuid>
                    <name>Kong reachable</name>
                    <mappings>
                        <mapping>
                            <value>0</value>
                            <newvalue>Not reachable</newvalue>
                        </mapping>
                        <mapping>
                            <value>1</value>
                            <newvalue>Reachable</newvalue>
                        </mapping>
                    </mappings>
                </valuemap>
            </valuemaps>
        </template>
    </templates>
    <triggers>
        <trigger>
            <uuid>fb595296d10c481f929ff8ca15793b23</uuid>
            <expression>last(/Kong Gateway by HTTP/kong.datastore_reachable)=0</expression>
            <name>Kong: datastore (Postgres) not reachable</name>
            <priority>HIGH</priority>
            <description>Kong reports it cannot reach its configuration datastore.</description>
            <tags>
                <tag>
                    <tag>scope</tag>
                    <value>availability</value>
                </tag>
            </tags>
        </trigger>
        <trigger>
            <uuid>e3ebd83279bc4a2ebbed34b6ca0a83b9</uuid>
            <expression>nodata(/Kong Gateway by HTTP/kong.metrics.raw,{$KONG.NODATA})=1</expression>
            <name>Kong: metrics endpoint unreachable</name>
            <priority>AVERAGE</priority>
            <description>No data scraped from Kong /metrics. Kong down, Status API off, or port blocked.</description>
            <tags>
                <tag>
                    <tag>scope</tag>
                    <value>availability</value>
                </tag>
            </tags>
        </trigger>
        <trigger>
            <uuid>ecf64178ad7a455f9689c7dc224675e0</uuid>
            <expression>avg(/Kong Gateway by HTTP/kong.requests.5xx.rate,5m)&gt;{$KONG.5XX.RATE.WARN}</expression>
            <name>Kong: high 5xx rate (&gt;{$KONG.5XX.RATE.WARN} rps for 5m)</name>
            <priority>WARNING</priority>
            <description>Sustained 5xx responses across all routes.</description>
            <tags>
                <tag>
                    <tag>scope</tag>
                    <value>availability</value>
                </tag>
            </tags>
        </trigger>
    </triggers>
</zabbix_export>
